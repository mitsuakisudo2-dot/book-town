{
  "name": "book-town",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5173",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "next build --webpack",
    "test:domain": "tsx tests/domain.test.ts",
    "test:walk-domain": "tsx tests/walk-domain.test.ts",
    "test:covers": "tsx tests/covers.test.ts",
    "test:customization-domain": "tsx tests/customization-domain.test.ts",
    "test:db": "tsx tests/database-policies.test.ts",
    "test:account": "tsx tests/account-domain.test.ts",
    "test:town-sync": "tsx tests/town-remote.test.ts && tsx tests/walk-remote.test.ts",
    "test:supabase": "tsx tests/supabase-login.test.ts && tsx tests/supabase-town.test.ts",
    "test:customization": "node tests/customization-journey.mjs",
    "test:walk": "node tests/walk-journey.mjs",
    "test:login": "node tests/login-journey.mjs",
    "test:browser": "node tests/browser-journey.mjs",
    "test:street": "node tests/street-journey.mjs",
    "format": "prettier --write src tests *.json *.ts *.mjs README.md",
    "test:feedback": "node tests/feedback-journey.mjs",
    "test:social": "node tests/social-journey.mjs",
    "test:app": "node tests/app-journey.mjs",
    "test:settings": "tsx tests/hosted-settings.test.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.117.3",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "~0.3.16",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
