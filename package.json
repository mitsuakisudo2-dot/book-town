{
  "name": "book-town",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5173",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "next build --webpack",
    "test:domain": "tsx tests/domain.test.ts",
    "test:browser": "node tests/browser-journey.mjs",
    "test:street": "node tests/street-journey.mjs",
    "format": "prettier --write src tests *.json *.ts *.mjs README.md",
    "test:feedback": "node tests/feedback-journey.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
