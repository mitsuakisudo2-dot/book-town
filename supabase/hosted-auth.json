{
  "site": {
    "url": "https://booktown.page",
    "returnTo": ["https://booktown.page/**"]
  },
  "code": {
    "length": 6,
    "expiresInSeconds": 600
  },
  "limits": {
    "codeRequestsPer5Minutes": 30,
    "codeChecksPer5Minutes": 30,
    "sessionRefreshesPer5Minutes": 150
  },
  "email": {
    "smtpHost": "smtp.resend.com",
    "smtpPort": 465,
    "smtpUser": "resend",
    "sender": "login@booktown.page",
    "senderName": "BookTown",
    "perHour": 30
  },
  "magicLink": {
    "subject": "BookTown のログインコード",
    "template": "templates/magic_link.html"
  },
  "emailChange": {
    "confirmBoth": true,
    "subject": "BookTown のメールアドレスの変更",
    "template": "templates/email_change.html"
  },
  "passkey": {
    "enabled": true,
    "relyingParty": "booktown.page",
    "name": "BookTown",
    "origins": ["https://booktown.page", "https://www.booktown.page"]
  },
  "captcha": {
    "provider": "turnstile",
    "on": true
  }
}
